# Database (SQLite for easy start – switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Meta Marketing API (https://developers.facebook.com/docs/marketing-api)
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""          # System user or long-lived token
META_AD_ACCOUNT_ID=""         # act_XXXXXXXX

# TikTok Marketing API (https://business-api.tiktok.com)
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_ADVERTISER_ID=""

# AdForge settings
PLATFORM_FEE_PERCENT=5
DEFAULT_CPM=1.50
DEFAULT_CPC=0.15
UPLOAD_DIR="./public/uploads"
